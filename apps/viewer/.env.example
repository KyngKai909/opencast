# The API, e.g. http://localhost:8787 (the viewer calls ${VITE_API_BASE}/v1/...).
VITE_API_BASE=http://localhost:8787
# Privy sign-in. Without it the app runs, and signing in says it isn't set up.
VITE_PRIVY_APP_ID=
# Master control, for "Run a station or offer your programs".
VITE_CONTROL_URL=http://localhost:5173
