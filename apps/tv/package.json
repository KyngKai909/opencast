{
  "name": "@opencast/tv",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "tsc -p tsconfig.json && vite build",
    "build:android": "tsc -p tsconfig.json && vite build --mode production && cap sync android",
    "build:tizen": "node scripts/build-tizen.mjs",
    "android:art": "node scripts/android-art.mjs",
    "tizen:art": "node scripts/tizen-art.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "echo \"No lint configured for tv\""
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/device": "^8.0.3",
    "@noriginmedia/norigin-spatial-navigation": "^3.3.0",
    "@opencast/contracts": "*",
    "@opencast/player": "*",
    "@opencast/ui": "*",
    "@tanstack/react-query": "^5.104.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router": "^7.13.0",
    "uqr": "^0.1.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.1",
    "jsdom": "^26.1.0",
    "msw": "^2.11.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
