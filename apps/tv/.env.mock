# npm run dev:mock: every API call is answered by Mock Service Worker (src/mocks), from the
# reference files' illustration data, validated against @opencast/contracts.
VITE_MOCK=true
# The reference frames' moment: Saturday, September 26, 8:42 pm in the Inland Empire. The mock
# clock starts here and runs on. Remove it to use the real time.
VITE_MOCK_CLOCK=2026-09-27T03:42:00Z
