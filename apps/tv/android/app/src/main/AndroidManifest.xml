<?xml version="1.0" encoding="utf-8"?>
<!--
  Opencast for Android TV and Fire TV: TV mode in a Capacitor WebView (docs/apps/native.md).
  A TV-only app: leanback is required, so phones and tablets never see it in a store.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- TV only: Google Play and the Amazon Appstore list it for TVs. Touch isn't needed. -->
    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Google TV is told from Android TV by its home screen being installed (OpencastTvPlugin.getInfo). -->
    <queries>
        <package android:name="com.google.android.apps.tv.launcherx" />
    </queries>

    <!--
      allowBackup off: the TV's identity (registerTv's device token) and its sign-in live in the
      WebView's storage, and must never be restored onto another TV.
      enableOnBackInvokedCallback off: Back reaches MainActivity as a key (targetSdk 36 would
      otherwise take it for predictive back and never deliver KEYCODE_BACK).
    -->
    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:enableOnBackInvokedCallback="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false"
        tools:targetApi="33">

        <activity
            android:name=".MainActivity"
            android:banner="@drawable/banner"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:exported="true"
            android:label="@string/title_activity_main"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:theme="@style/AppTheme.NoActionBarLaunch">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- Android TV and Google TV's launcher row. -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <!-- Fire TV's Your Apps (and sideloaded installs) look for the plain launcher. -->
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>
</manifest>
