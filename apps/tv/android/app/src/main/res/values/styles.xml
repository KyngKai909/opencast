<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- TV mode is always dark, full screen, no action bar. The ground is TV mode's (#0F1830). -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">#0F1830</item>
        <item name="colorPrimaryDark">#0F1830</item>
        <item name="colorAccent">#6CCFEA</item>
        <item name="android:windowBackground">@color/tv_ground</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@color/tv_ground</item>
        <item name="android:background">@null</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:windowFullscreen">true</item>
        <item name="windowSplashScreenBackground">@color/tv_ground</item>
    </style>
</resources>
