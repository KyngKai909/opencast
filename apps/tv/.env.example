# The API, e.g. https://api.useopencast.org (TV mode calls ${VITE_API_BASE}/v1/...).
VITE_API_BASE=
# The viewer app, for "sign in on your phone" (its /tv page approves the TV's code).
VITE_VIEWER_URL=http://localhost:5174
# The Cast application id for receiver.html, from the Google Cast console.
VITE_CAST_APP_ID=
