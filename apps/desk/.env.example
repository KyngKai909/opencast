# The API, e.g. http://localhost:8787 (the desk calls ${VITE_API_BASE}/v1/...). Blank: same origin.
VITE_API_BASE=
# Opencast's own Privy app (never Clear's). Without it, signing in says it isn't set up. The desk
# opens only for accounts the API marks isAdmin.
VITE_PRIVY_APP_ID=
# Master control, for "Open in master control".
VITE_CONTROL_URL=http://localhost:5173
# npm run dev:mock: every API call is answered by Mock Service Worker (src/mocks), from the
# reference file's illustration data, validated against @opencast/contracts.
VITE_MOCK=false
# Mock mode only: where the clock starts. `?clock=<ISO>` in the address starts it elsewhere.
VITE_MOCK_CLOCK=
