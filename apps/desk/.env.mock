# npm run dev:mock: every API call is answered by Mock Service Worker (src/mocks), from the
# reference file's illustration data (docs/reference/desk), validated against @opencast/contracts.
# Sign in as dee@opencast.example (Dee A., on the Opencast team) with any six digits but 000000;
# any other address is signed in but isn't on the team.
VITE_MOCK=true
# The reference's moment: Saturday, September 26, 8:42 pm in the Inland Empire, the same as the
# other apps' mocks. `?clock=<ISO>` in the address starts it elsewhere.
VITE_MOCK_CLOCK=2026-09-27T03:42:12Z
# The viewer app in mock mode, where the creator's permission page lives (/permission/:token).
VITE_VIEWER_URL=http://localhost:5174
