{
  "name": "@opencast/control",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "if [ -n \"$RAILWAY_ENVIRONMENT\" ]; then node server.mjs; else vite; fi",
    "dev:mock": "vite --mode mock --port 5179",
    "build": "tsc -p tsconfig.json && vite build",
    "start": "node server.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "echo \"No lint configured for control\""
  },
  "dependencies": {
    "@opencast/contracts": "*",
    "@opencast/player": "*",
    "@opencast/ui": "*",
    "@privy-io/react-auth": "^3.45.0",
    "@tanstack/react-query": "^5.104.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router": "^7.13.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.1",
    "jsdom": "^26.1.0",
    "msw": "^2.11.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
