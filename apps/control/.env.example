# Master control on Railway: server.mjs proxies /v1 to the API over private networking.
API_PROXY_BASE_URL=http://api.railway.internal:8080
# Or set VITE_API_BASE to call the API directly from the browser (e.g. http://localhost:8787).
VITE_API_BASE=
# Privy sign-in (email, Apple, Google and wallets). Without it, signing in says it isn't set up.
VITE_PRIVY_APP_ID=
# The viewer app, for "See it as viewers do".
VITE_VIEWER_URL=http://localhost:5174
