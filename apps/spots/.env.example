# The API, e.g. http://localhost:8787 (the app calls ${VITE_API_BASE}/v1/...). Blank: same origin.
VITE_API_BASE=
# Privy sign-in (email, Apple, Google). Without it, signing in says it isn't set up.
VITE_PRIVY_APP_ID=
# Clear's Privy provider app id, for "Connect Clear" (cross-app linking). Without it, Connect Clear
# says it isn't set up here.
VITE_CLEAR_PRIVY_PROVIDER_APP_ID=
