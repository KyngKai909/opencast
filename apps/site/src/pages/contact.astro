import Base from "../layouts/Base.astro";
// After Base, so the page's CSS follows the global layers (the reference's cascade).
import "../styles/pages/network.css";
import Footer from "../components/Footer.astro";
import FooterNetwork from "../components/footers/FooterNetwork.astro";
---
<Base page="contact">
