---
// /contact (SITE-SPEC §7; no reference yet). The switchboard hero: pick a desk and a patch cable
// runs to its lamp, and the form beside it follows the desk. Then the six desks, where we are, a
// short FAQ and the footer. Built from the site's own parts; new copy is in docs/site/new-copy.md.
// Behaviour: src/scripts/contact.ts.
import Base from "../layouts/Base.astro";
import { faqPage } from "../lib/ld";
// After Base, so the page's CSS follows the global layers (the reference's cascade).
import "../styles/pages/network.css";
import Btn from "../components/Btn.astro";
import Cell from "../components/Cell.astro";
import Faq from "../components/Faq.astro";
import Footer from "../components/Footer.astro";
import Mf from "../components/Mf.astro";
import Mh from "../components/Mh.astro";
import Sheet from "../components/Sheet.astro";
import FooterNetwork from "../components/footers/FooterNetwork.astro";
import { CONTACT_FAQ, DESKS, HOURS_CLOSED, HOURS_OPEN, isOpen, TAKEDOWN_URL } from "../data/contact";

const open = isOpen();
const jackX = (i: number) => 40 + i * 80;
---
<Base page="contact" st="#5B7BE0">
  <script slot="head" type="application/ld+json" set:html={faqPage(CONTACT_FAQ)} />
  <main id="top" class="ct">
    <section class="blk rhero ct-hero" id="hero">
      <Sheet>
        <Cell class="hd ct-top" d={12}>
          <Mh label="Contact" meta="Six desks" />
          <div class="ct-head">
            <h1 class="sy-h"><span>Talk to a person.</span><span class="dim">We pick up.</span></h1>
            <p class="lede">Six desks, each run by people who know that part of the dial. Pick one on the switchboard and say what you need.</p>
          </div>
        </Cell>

        <Cell class="ct-sb" d={5} t={6} id="switchboard">
          <div class="mh"><span id="sbDesk">Pick a desk</span><span id="sbHours" class:list={["ct-hours", { open }]}>{open ? <><i></i>{HOURS_OPEN}</> : HOURS_CLOSED}</span></div>
          <div class="ct-panel">
            <svg class="ct-svg" viewBox="0 0 480 300" aria-hidden="true">
              <defs>
                <radialGradient id="ctGlow" cx="0.5" cy="0" r="1"><stop offset="0" stop-color="#FFF4D6" stop-opacity=".55" /><stop offset="1" stop-color="#FFF4D6" stop-opacity="0" /></radialGradient>
                <pattern id="ctGrid" width="20" height="20" patternUnits="userSpaceOnUse"><path d="M20 0H0V20" fill="none" stroke="#F3EAD9" stroke-opacity=".04" /></pattern>
              </defs>
              <rect width="480" height="300" fill="url(#ctGrid)" />
              <g class="ct-lamp" transform="translate(-150 0)">
                <path class="ct-cone" d="M318 92 L262 228 L442 228 L386 92 Z" fill="url(#ctGlow)" />
                <path d="M408 210 L392 132 L352 96" fill="none" stroke="#3a3354" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" />
                <circle cx="392" cy="132" r="5" fill="#4b4368" />
                <path class="ct-shade" d="M330 60 L374 60 L392 92 L312 92 Z" fill="#2a2342" stroke="#4b4368" stroke-width="2" stroke-linejoin="round" />
                <circle class="ct-bulb" cx="352" cy="96" r="9" fill="#3a3354" />
                <rect x="384" y="206" width="48" height="10" rx="2" fill="#2a2342" stroke="#4b4368" stroke-width="2" />
                <circle class="ct-socket" cx="408" cy="200" r="7" fill="#0b0816" stroke="#4b4368" stroke-width="2" />
              </g>
              <path class="ct-cable" id="ctCable" d="" fill="none" stroke-width="5" stroke-linecap="round" />
              <circle class="ct-plug" id="ctPlug" r="6" cx="-20" cy="-20" />
              {DESKS.map((d, i) => (
                <g class="ct-jack" data-i={i} style={`--c:${d.c}`}>
                  <circle cx={jackX(i)} cy="262" r="15" fill="#0b0816" stroke="#4b4368" stroke-width="2" />
                  <circle cx={jackX(i)} cy="262" r="6" fill="#000" />
                  <circle class="ct-led" cx={jackX(i)} cy="234" r="3.5" />
                </g>
              ))}
            </svg>
            <div class="ct-jacks" role="radiogroup" aria-label="Desks" id="sbJacks">
              {DESKS.map((d, i) => <button type="button" role="radio" aria-checked="false" tabindex={i === 0 ? 0 : -1} data-desk={d.id} style={`--c:${d.c}`}>{d.jack}</button>)}
            </div>
          </div>
          <Mf><span id="sbNote">Six desks. A person on each.</span></Mf>
        </Cell>

        <Cell class="ct-fc" d={7} t={6} id="message">
          <div class="mh"><span>Your message</span><span id="fcTo">Pick a desk</span></div>
          <form class="ct-form" id="ctForm" novalidate>
            <p class="ct-pick" id="ctPick">Pick a desk on the switchboard, and the form asks for what that desk needs.</p>
            <div class="ct-row">
              <div class="ct-f"><label class="ct-l" for="ctName">Name</label><input class="ct-in" id="ctName" name="name" autocomplete="name" maxlength="80" required aria-describedby="ctNameE" /><small class="ct-e" id="ctNameE"></small></div>
              <div class="ct-f"><label class="ct-l" for="ctEmail">Email</label><input class="ct-in" id="ctEmail" name="email" type="email" inputmode="email" autocomplete="email" required aria-describedby="ctEmailE" /><small class="ct-e" id="ctEmailE"></small></div>
            </div>
            {DESKS.map((d) => (
              <fieldset class="ct-desk" data-desk={d.id} hidden>
                <legend class="sr">For the {d.name}</legend>
                <div class="ct-row">
                  {d.fields.map((f) => f.type === "radio" ? (
                    <div class="ct-f ct-wide"><span class="ct-l" id={`ct-${d.id}-${f.name}-l`}>{f.label}</span><div class="seg2 ct-seg" role="radiogroup" aria-labelledby={`ct-${d.id}-${f.name}-l`} data-field={f.name}>{f.options!.map(([v, l], k) => <button type="button" role="radio" data-v={v} aria-checked={k === 0 ? "true" : "false"} class:list={{ on: k === 0 }} tabindex={k === 0 ? 0 : -1}>{l}</button>)}</div></div>
                  ) : (
                    <div class="ct-f"><label class="ct-l" for={`ct-${d.id}-${f.name}`}>{f.label}</label><input class="ct-in" id={`ct-${d.id}-${f.name}`} data-field={f.name} type={f.type ?? "text"} autocomplete={f.autocomplete ?? "off"} maxlength="400" aria-describedby={f.hint ? `ct-${d.id}-${f.name}-h` : undefined} />{f.hint && <small class="ct-h" id={`ct-${d.id}-${f.name}-h`}>{f.hint}</small>}</div>
                  ))}
                </div>
                {d.id === "rights" && <p class="ct-note">For a formal takedown, use the <a href={TAKEDOWN_URL}>takedown form</a>.</p>}
              </fieldset>
            ))}
            <div class="ct-f ct-wide"><label class="ct-l" for="ctMsg">Message</label><textarea class="ct-in ct-ta" id="ctMsg" name="message" rows="5" maxlength="4000" required aria-describedby="ctMsgE"></textarea><small class="ct-e" id="ctMsgE"></small></div>
            <p class="ct-err" id="ctErr" role="alert"></p>
            <div class="acts"><Btn button type="submit" live="+1" id="ctGo">Send it</Btn></div>
          </form>
          <div class="ct-sent" id="ctSent" hidden tabindex="-1">
            <h2 id="ctSentH">Patched through.</h2>
            <p class="lede" id="ctSentP"></p>
            <div class="acts"><Btn button ghost id="ctAgain">Write another</Btn></div>
          </div>
        </Cell>
      </Sheet>
    </section>

    <section class="blk" id="desks">
      <Sheet>
        {DESKS.map((d) => (
          <Cell class="ct-dk" d={2} t={2} m={1} style={`--c:${d.c}`}>
            <div class="mh"><span><i class="sq"></i>{d.jack}</span></div>
            <div class="cb"><a class="ct-mail" href={`mailto:${d.email}`}>{d.email}</a><p>{d.handles}</p></div>
            <Mf><span>{d.answers.charAt(0).toUpperCase() + d.answers.slice(1)}</span></Mf>
          </Cell>
        ))}
      </Sheet>
    </section>

    <section class="blk" id="where">
      <Sheet>
        <Cell class="hd" d={7} t={6}>
          <Mh ix="01" label="Where we are" meta="Southern California" />
          <div class="cb"><h2>Where<br />we are.</h2><p class="lede">Southern California. We're filling the Inland Empire first, then Los Angeles and Orange County. Anyone anywhere can sign on; those are just the markets we're filling first.</p></div>
        </Cell>
        <Cell class="ct-map" d={5} t={6}>
          <Mh label="First markets" meta="Example map" />
          <div class="ct-mapw">
            <svg viewBox="0 0 400 400" role="img" aria-label="A map of Southern California: the Inland Empire, first, east of Los Angeles and Orange County, which are next.">
              <defs><pattern id="ctMapGrid" width="20" height="20" patternUnits="userSpaceOnUse"><path d="M20 0H0V20" fill="none" stroke="#F3EAD9" stroke-opacity=".035" /></pattern></defs>
              <rect width="400" height="400" fill="url(#ctMapGrid)" />
              <path class="ct-coast" d="M0 150 C40 160 70 175 92 196 C108 212 122 226 140 236 C160 247 176 262 188 280 C200 298 212 318 226 340 C236 356 244 374 250 400" />
              <path class="ct-sea" d="M0 150 C40 160 70 175 92 196 C108 212 122 226 140 236 C160 247 176 262 188 280 C200 298 212 318 226 340 C236 356 244 374 250 400 L0 400 Z" />
              <g class="ct-links"><path d="M290 190 C240 170 200 175 150 196" /><path d="M290 190 C262 220 232 238 206 262" /></g>
              <g class="ct-mk ct-mk-on" style="--c:#5B7BE0"><circle cx="290" cy="190" r="34" class="ct-ring" /><circle cx="290" cy="190" r="8" /><text x="290" y="244" text-anchor="middle">Inland Empire</text><text x="290" y="260" text-anchor="middle" class="ct-st">First</text></g>
              <g class="ct-mk" style="--c:#C04A9E"><circle cx="150" cy="196" r="6" /><text x="150" y="176" text-anchor="middle">Los Angeles</text><text x="150" y="162" text-anchor="middle" class="ct-st">Next</text></g>
              <g class="ct-mk" style="--c:#E0583A"><circle cx="206" cy="262" r="6" /><text x="214" y="290" text-anchor="start">Orange County</text><text x="214" y="306" text-anchor="start" class="ct-st">Next</text></g>
            </svg>
          </div>
          <Mf><span>Markets are sets of ZIP codes. The map is a sketch, not to scale.</span></Mf>
        </Cell>
      </Sheet>
    </section>

    <section class="blk" id="faq">
      <Sheet>
        <Cell class="hd" d={5} t={6}><Mh ix="02" label="Questions" /><div class="cb"><h2>Before<br />you write.</h2></div></Cell>
        <Cell class="faq" d={7} t={6}><Mh label="Questions people ask" meta={`${CONTACT_FAQ.length} answers`} /><Faq items={CONTACT_FAQ} /></Cell>
      </Sheet>
    </section>
  </main>
  <Footer slot="footer"><FooterNetwork slot="first" /></Footer>
</Base>
<script>
  import { initContact } from "../scripts/contact";
  initContact();
</script>
<style is:global>
  /* ---- hero ---- */
  .ct-top .ct-head{display:grid;grid-template-columns:minmax(0,7fr) minmax(0,5fr);gap:clamp(24px,4vw,64px);align-items:end;padding:clamp(28px,3.4vw,56px) var(--pad) clamp(28px,3vw,44px)}
  .ct-top .sy-h{font-size:clamp(56px,7.4vw,138px);line-height:.88;text-transform:uppercase;margin:0}
  .ct-top .lede{max-width:44ch}
  @media (max-width:1099px){ .ct-top .ct-head{grid-template-columns:1fr;align-items:start} .ct-top .sy-h{font-size:clamp(52px,9.6vw,100px)} }
  @media (max-width:699px){ .ct-top .sy-h{font-size:clamp(38px,11vw,58px)} }
  @media (min-width:1100px){ .ct-sb{order:2} }

  /* ---- the switchboard ---- */
  .ct-hours{display:inline-flex;align-items:center;gap:7px}
  .ct-hours.open{color:var(--tally)}
  .ct-hours i{width:7px;height:7px;border-radius:50%;background:var(--tally);box-shadow:0 0 8px var(--tally);animation:pulse 1.8s infinite}
  .ct-panel{padding:18px var(--pad) 8px}
  .ct-svg{display:block;width:100%;height:auto;background:#0b0816;box-shadow:inset 0 0 0 1px var(--rule)}
  .ct-cone{opacity:0;transition:opacity .5s .45s}
  .ct-bulb{transition:fill .3s .45s,filter .3s .45s}
  .ct.patched .ct-cone{opacity:1}
  .ct.patched .ct-bulb{fill:#FFF4D6;filter:drop-shadow(0 0 8px #FFE7A8)}
  .ct.patched .ct-socket{stroke:var(--desk,#F3EAD9)}
  .ct-cable{stroke:var(--desk,#F3EAD9);filter:drop-shadow(0 3px 4px rgb(0 0 0 / .5))}
  .ct-cable.draw{animation:ctdraw .6s var(--ease) forwards}
  .ct-plug{fill:var(--desk,#F3EAD9)}
  .ct-led{fill:#2a2342;transition:fill .3s,filter .3s}
  .ct-jack.on .ct-led{fill:var(--c);filter:drop-shadow(0 0 5px var(--c))}
  .ct-jack.on circle:first-child{stroke:var(--c)}
  @keyframes ctdraw{to{stroke-dashoffset:0}}
  .ct-jacks{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));margin-top:10px}
  .ct-jacks button{min-height:44px;padding:6px 2px;border:0;background:none;color:var(--muted);font:600 10.5px/1.2 var(--text);letter-spacing:.1em;text-transform:uppercase;cursor:pointer;border-radius:999px;transition:color .2s,background .2s}
  .ct-jacks button:hover{color:var(--glow);background:rgb(243 234 217 / .05)}
  .ct-jacks button[aria-checked="true"]{color:var(--glow)}
  .ct-jacks button[aria-checked="true"]::before{content:"";display:block;width:16px;height:2px;margin:0 auto 6px;background:var(--c);box-shadow:0 0 6px var(--c)}
  @media (max-width:699px){ .ct-jacks button{font-size:10.5px;letter-spacing:0;text-transform:none;padding:6px 0;overflow-wrap:anywhere} }
  @media (prefers-reduced-motion:reduce){ .ct-cable.draw{animation:none;stroke-dashoffset:0!important} .ct-cone,.ct-bulb{transition:none} }

  /* ---- the form ---- */
  .ct-form{display:flex;flex-direction:column;gap:18px;padding:clamp(20px,2.4vw,32px) var(--pad)}
  .ct-pick{font-size:14.5px;color:var(--muted)}
  .ct-row{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px 18px}
  .ct-desk{border:0;margin:0;padding:0;min-width:0;display:flex;flex-direction:column;gap:14px}
  .ct-f{display:flex;flex-direction:column;gap:8px;min-width:0}
  .ct-wide{grid-column:1 / -1}
  .ct-l{font:600 11px/1 var(--text);letter-spacing:.13em;text-transform:uppercase;color:var(--muted)}
  .ct-in{height:50px;width:100%;padding:0 14px;border:0;border-radius:2px;background:rgb(243 234 217 / .05);box-shadow:inset 0 0 0 1px rgb(243 234 217 / .16);color:var(--glow);font:500 16px var(--text)}
  .ct-in:hover{box-shadow:inset 0 0 0 1px rgb(243 234 217 / .28)}
  .ct-in:focus{outline:none;box-shadow:inset 0 0 0 1.5px var(--desk,var(--glow))}
  .ct-in[aria-invalid="true"]{box-shadow:inset 0 0 0 1.5px var(--tally)}
  .ct-ta{height:auto;min-height:132px;padding:12px 14px;line-height:1.5;resize:vertical}
  .ct-h{font-size:12.5px;color:var(--muted)}
  .ct-e,.ct-err{font-size:12.5px;color:#ff8a80}
  .ct-err{font-size:14px}
  .ct-e:empty,.ct-err:empty{display:none}
  .ct-seg{align-self:flex-start;max-width:100%}
  .ct-note{font-size:13.5px;color:var(--muted)}
  .ct-note a{color:var(--glow)}
  .ct-form .acts,.ct-sent .acts{display:flex;gap:12px;flex-wrap:wrap}
  .ct-form .btn[aria-busy="true"]{opacity:.6;cursor:progress}
  .ct-sent{padding:clamp(28px,3vw,44px) var(--pad);display:flex;flex-direction:column;gap:14px;outline:none}
  .ct-sent h2{font-size:clamp(40px,4.4vw,64px);line-height:.94;text-transform:uppercase}
  .ct-sent .acts{margin-top:10px}
  @media (max-width:699px){ .ct-row{grid-template-columns:1fr} }

  /* ---- desks ---- */
  .ct-dk .cb{display:flex;flex-direction:column;gap:10px;padding:18px var(--pad) 22px}
  .ct-mail{font:600 14px/1.3 var(--text);color:var(--glow);text-decoration-color:color-mix(in srgb,var(--c) 70%,transparent);text-underline-offset:3px;overflow-wrap:anywhere}
  .ct-dk p{font-size:13.5px;line-height:1.5;color:rgb(243 234 217 / .72)}
  .ct-dk .mf{font-size:12px;color:var(--muted)}

  /* ---- the map ---- */
  .ct-mapw{padding:18px var(--pad)}
  .ct-mapw svg{display:block;width:100%;height:auto;aspect-ratio:1;background:#0b0816;box-shadow:inset 0 0 0 1px var(--rule)}
  .ct-coast{fill:none;stroke:#F3EAD9;stroke-opacity:.22;stroke-width:1.5;stroke-dasharray:3 5}
  .ct-sea{fill:#5B7BE0;fill-opacity:.05}
  .ct-links path{fill:none;stroke:#F3EAD9;stroke-opacity:.16;stroke-width:1.2;stroke-dasharray:3 5}
  .ct-mk circle{fill:var(--c)}
  .ct-mk text{font:600 12px var(--text);fill:var(--glow)}
  .ct-mk .ct-st{font:400 15px var(--osd);fill:var(--muted)}
  .ct-mk-on .ct-ring{fill:color-mix(in srgb,var(--c) 14%,transparent);stroke:var(--c);stroke-opacity:.6;stroke-width:1.5}
  .ct-mk-on .ct-st{fill:var(--tally)}
  @media (prefers-reduced-motion:no-preference){ .ct-mk-on .ct-ring{animation:ctping 2.4s var(--ease) infinite;transform-origin:290px 190px} }
  @keyframes ctping{0%,100%{opacity:1}50%{opacity:.45}}
</style>
