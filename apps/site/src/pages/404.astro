---
// 404 (SITE-SPEC §7): "Off the air." over a screen of static, with the station bug "--.-".
import Base from "../layouts/Base.astro";
import Btn from "../components/Btn.astro";
import Cell from "../components/Cell.astro";
import Mh from "../components/Mh.astro";
import Sheet from "../components/Sheet.astro";
import { watch } from "../data/links";
import { NOW_PLAYING } from "../data/stations";
---
<Base title="Off the air | Dial" description="There's nothing on this channel." noindex>
  <main id="top" class="oa">
    <section class="blk oa-blk">
      <Sheet>
        <Cell d={12} class="oa-cell">
          <Mh label="No signal" meta="--.-" />
          <div class="oa-scr">
            <canvas id="oaStatic" aria-hidden="true"></canvas>
            <div class="oa-scan" aria-hidden="true"></div>
            <div class="oa-vig" aria-hidden="true"></div>
            <div class="oa-bug" aria-hidden="true">--.-</div>
            <div class="oa-copy">
              <h1>Off the air.</h1>
              <p>There's nothing on this channel.</p>
              <div class="acts"><Btn cta={watch(NOW_PLAYING.n)} live={NOW_PLAYING.n} cur="Watch">Open the dial</Btn><Btn href="/" ghost>Back to the start</Btn></div>
            </div>
          </div>
        </Cell>
      </Sheet>
    </section>
  </main>
</Base>
<script>
  // The static: a coarse field of noise redrawn about 20 times a second, scaled up without
  // smoothing to the screen's box at devicePixelRatio. Paused off screen and in a hidden tab;
  // one still frame under reduced motion.
  import { dpr, loop } from "../lib/canvas";
  const c = document.getElementById("oaStatic") as HTMLCanvasElement;
  const src = document.createElement("canvas");
  const paint = () => {
    const sx = src.getContext("2d")!, id = sx.createImageData(src.width, src.height), d = id.data;
    for (let i = 0; i < d.length; i += 4) {
      const v = Math.random() * 255;
      d[i] = v * 0.92;
      d[i + 1] = v * 0.9;
      d[i + 2] = v;
      d[i + 3] = 255;
    }
    sx.putImageData(id, 0, 0);
    const x = c.getContext("2d")!;
    x.imageSmoothingEnabled = false;
    x.drawImage(src, 0, 0, c.width, c.height);
  };
  const size = () => {
    const r = c.getBoundingClientRect(), k = dpr();
    c.width = Math.round(r.width * k);
    c.height = Math.round(r.height * k);
    // About 3 CSS pixels a grain, at most 480 across.
    src.width = Math.max(120, Math.min(480, Math.round(r.width / 3)));
    src.height = Math.max(60, Math.round((src.width * r.height) / Math.max(1, r.width)));
    paint();
  };
  size();
  addEventListener("resize", size);
  loop(paint, { every: 50, watch: [c] });
</script>
<style is:global>
  .oa-blk{padding-top:clamp(96px,10vw,140px)}
  .oa-scr{position:relative;min-height:min(72svh,720px);overflow:hidden;background:#000}
  .oa-scr canvas{position:absolute;inset:0;width:100%;height:100%;display:block;opacity:.5}
  .oa-scan{position:absolute;inset:0;pointer-events:none;background:repeating-linear-gradient(0deg,rgb(0 0 0 / .3) 0 1px,transparent 1px 3px);mix-blend-mode:multiply}
  .oa-vig{position:absolute;inset:0;pointer-events:none;background:radial-gradient(120% 95% at 60% 40%,transparent 35%,rgb(8 5 18 / .85) 100%),linear-gradient(0deg,rgb(14 10 28 / .92) 0%,transparent 55%)}
  .oa-bug{position:absolute;top:clamp(18px,3vw,36px);right:clamp(18px,3vw,40px);font:400 clamp(44px,6vw,72px)/.8 var(--osd);color:#E9FFE8;text-shadow:0 0 14px rgb(130 255 170 / .55),0 0 2px #fff}
  .oa-copy{position:absolute;left:var(--pad);right:var(--pad);bottom:clamp(24px,4vw,56px)}
  .oa-copy h1{font-size:clamp(64px,11vw,184px);line-height:.86;text-transform:uppercase}
  .oa-copy p{margin-top:18px;font-size:clamp(17px,1.4vw,20px);color:rgb(243 234 217 / .86)}
  .oa-copy .acts{display:flex;gap:12px;flex-wrap:wrap;margin-top:26px}
  @media (max-width:699px){ .oa-scr{min-height:70svh} }
</style>
