# The Dial site (apps/site). Every value is read at build time (Astro's PUBLIC_ variables).
# Blank values use the defaults in src/data/links.ts.

# `waitlist` (default): every call to action opens the waitlist sheet.
# `live`: calls to action link into the apps below.
PUBLIC_LAUNCH_MODE=waitlist

# Where "Open the dial" / Watch goes. Default `/` (the home page's guide). In live mode the
# nav's tuner adds `/?ch=<number>`.
PUBLIC_WATCH_URL=

# The apps, for live mode: master control (claim, offer, market) and Dial for business.
PUBLIC_APP_URL=
PUBLIC_BUSINESS_URL=

# The API's origin (the site calls ${PUBLIC_API_URL}/v1/waitlist). Blank: the waitlist and
# contact forms are answered by the in-page mocks (src/mocks), so the site runs with no API.
PUBLIC_API_URL=
