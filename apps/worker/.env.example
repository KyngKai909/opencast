# The worker on Railway (one replica). Local development reads the root .env instead.
NODE_ENV=production
PORT=8080
DATABASE_URL=
REDIS_URL=
APP_ORIGIN=https://app.example.com
# The business app: business invites and business notices' emails link there
BUSINESS_ORIGIN=https://business.example.com
# Email through Resend (unset key: emails only go to the log). EMAIL_FROM on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=Opencast <hello@example.com>
EMAIL_REPLY_TO=
STORAGE_ROOT=/data/storage
WORKER_CACHE_DIR=/data/cache
WORKER_CACHE_GB=99.5
LEGACY_PLAYOUT=off

R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
S3_FORCE_PATH_STYLE=false
S3_STORAGE_CLASSES=true

PRIVY_APP_ID=
PRIVY_VERIFICATION_KEY=
LIVEPEER_API_KEY=
PAYMENTS_PROVIDER=fake
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

CHAIN_RPC_URL=
CHAIN_ID=
ESCROW_CONTRACT_ADDRESS=
CREATOR_FUND_ADDRESS=
USDC_ADDRESS=
# Sends the weekly escrow batch and the pool's fund share. The worker only.
SETTLEMENT_PRIVATE_KEY=
