# npm run dev:mock: every API call is answered by Mock Service Worker (src/mocks), from the
# reference files' illustration data, validated against @opencast/contracts.
VITE_MOCK=true
# The mock clock starts here and runs on: Saturday, September 26, 8:42 pm in the Inland Empire,
# the same moment as master control's mock. `?clock=<ISO>` in the address starts it elsewhere.
VITE_MOCK_CLOCK=2026-09-27T03:42:12Z
