# The API, e.g. http://localhost:8787 (the app calls ${VITE_API_BASE}/v1/...). Blank: same origin
# (`npm run dev` proxies /v1 to :8787).
VITE_API_BASE=http://localhost:8787
# Opencast's own Privy app (never Clear's): one sign-in for the viewer, master control and the
# desk. Without it the app runs, and signing in says it isn't set up.
VITE_PRIVY_APP_ID=
# Clear's Privy provider app id, for master control's "Connect Clear" (cross-app linking). Without
# it, Connect Clear says it isn't set up here.
VITE_CLEAR_PRIVY_PROVIDER_APP_ID=
# Opencast's Cast receiver application id, from the Google Cast console (the same as TV mode's).
# Without it, "Watch on" offers no Chromecasts on the web.
VITE_CAST_APP_ID=
# TV mode (apps/tv). dev:mock's Cast sender reaches TV mode's receiver.html through its bridge page.
VITE_TV_URL=http://localhost:5175
# The public site (apps/site), whose #join is the waitlist: where an ended waitlist invite sends
# people to reserve a call sign again.
VITE_SITE_URL=http://localhost:5176
# The iPhone app's external display: TV mode from the copy inside the app (bundled, the default) or
# from VITE_TV_URL (url; for live reload against TV mode's dev server). docs/apps/native.md.
VITE_MIRROR_TV=bundled
# npm run dev:mock sets these (.env.mock): every API call answered by Mock Service Worker, and
# where the mock clock starts. `?clock=<ISO>` in the address starts it elsewhere.
VITE_MOCK=false
VITE_MOCK_CLOCK=
# Dev server only: the real-API e2e runs' test sign-in (docs/apps/testing.md). Never in a build.
VITE_DEV_TOKEN_AUTH=false
