# npm run dev:mock: every API call is answered by Mock Service Worker (src/mocks), from the
# reference files' illustration data, validated against @opencast/contracts. One mock world for the
# three areas: sign in as kai@example.com (Kai M.: watches, and owns BEAT 12.1 in master control),
# marcus@, jen@ or sam@example.com (master control's team and a studio), or dee@opencast.example
# (Dee A., on the Opencast team, for Network desk), with any six digits but 000000.
VITE_MOCK=true
# The reference frames' moment: Saturday, September 26, 8:42:12 pm in the Inland Empire (the viewer's
# frames read 8:42 pm, master control's clock 8:42:12 pm). The mock clock starts here and runs on.
# `?clock=<ISO>` in the address starts it elsewhere; remove this to use the real time.
VITE_MOCK_CLOCK=2026-09-27T03:42:12Z
