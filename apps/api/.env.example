# The API on Railway. Local development reads the root .env instead.
NODE_ENV=production
PORT=8080
DATABASE_URL=
REDIS_URL=
APP_ORIGIN=https://app.example.com
WEB_ORIGIN=https://app.example.com,https://control.example.com,https://spots.example.com,https://desk.example.com,https://www.example.com,https://tv.example.com
STORAGE_ROOT=/tmp/opencast
JOBS=off
SERVE_WEB_APP=false

# Object storage (R2 in production; any S3-compatible store works)
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE=
S3_FORCE_PATH_STYLE=false
S3_STORAGE_CLASSES=true

# Sign-in
PRIVY_APP_ID=
PRIVY_VERIFICATION_KEY=
PRIVY_APP_SECRET=

LIVEPEER_API_KEY=

# Money: fake, clear or stripe_only
PAYMENTS_PROVIDER=fake
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# The escrow contract (read-only here; the worker sends)
CHAIN_RPC_URL=
CHAIN_ID=
ESCROW_CONTRACT_ADDRESS=
CREATOR_FUND_ADDRESS=
USDC_ADDRESS=
