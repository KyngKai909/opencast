# The API on Railway. Local development reads the root .env instead.
NODE_ENV=production
PORT=8080
DATABASE_URL=
# Redis: the TV remote's relay across API replicas (pub/sub)
REDIS_URL=
APP_ORIGIN=https://app.example.com
# The business app: business invites and business notices' emails link there
BUSINESS_ORIGIN=https://business.example.com
# Email through Resend (unset key: emails only go to the log). EMAIL_FROM on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=Opencast <hello@example.com>
EMAIL_REPLY_TO=
# Accepting an invite needs the invited email on the account; "off" turns that check off
INVITE_EMAIL_MATCH=on
WEB_ORIGIN=https://app.example.com,https://business.example.com,https://www.example.com,https://tv.example.com
STORAGE_ROOT=/tmp/opencast
JOBS=off
SERVE_WEB_APP=false
# The market from a TV's connection: an ip-to-postal lookup with {ip} in it (optional)
GEOIP_URL=
# Businesses' addresses to coordinates: a geocoding lookup with {q} in it (optional; unset, businesses choose Online)
PLACES_URL=
PLACES_USER_AGENT=
# The API's own public origin: paths it serves (/objects/..., receipt PDFs, checkout webhooks) are sent as full URLs
API_PUBLIC_URL=https://api.example.com
# Where the worker serves stations' own HLS, when a station has no Livepeer output (optional)
HLS_PUBLIC_URL=
# A237: the HTTPS relay for external stations' http:// stream links (docs/stream-relay.md), and the
# secret shared with it (optional; unset, an http link plays only if it answers over https)
STREAM_RELAY_BASE=
STREAM_RELAY_SECRET=
# Proxies adding X-Forwarded-For before the API (Railway's edge: 1)
TRUST_PROXY_HOPS=1

# Object storage (R2 in production; any S3-compatible store works)
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE=
S3_FORCE_PATH_STYLE=false
S3_STORAGE_CLASSES=true
# Direct uploads (docs/uploads.md): origins besides APP_ORIGIN and BUSINESS_ORIGIN the bucket's CORS
# rule allows (comma-separated; `npm run storage:uploads-bucket -w @opencast/api`), and, on local disk
# only, what the API's own part URLs are signed with (optional; derived from STORAGE_ROOT otherwise)
UPLOAD_CORS_ORIGINS=
LOCAL_UPLOAD_SECRET=

# Sign-in
PRIVY_APP_ID=
PRIVY_VERIFICATION_KEY=
PRIVY_APP_SECRET=
# Clear as a Privy global wallet: Clear's provider app ID, and read_only or full
CLEAR_PRIVY_PROVIDER_APP_ID=
CLEAR_WALLET_ACCESS=read_only

LIVEPEER_API_KEY=

# Money: fake, clear or stripe_only
PAYMENTS_PROVIDER=fake
# Opencast's own restricted key (rk_test_… here; rk_live_… only in production; sk_… is refused), and its own webhook's secret (docs/stripe.md).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
# On every card charge, and metadata.app on everything Opencast makes in Stripe (webhook events without it are ignored).
STRIPE_STATEMENT_DESCRIPTOR_SUFFIX=OPENCAST
STRIPE_METADATA_APP=opencast

# The escrow contract (read-only here; the worker sends)
CHAIN_RPC_URL=
CHAIN_ID=
ESCROW_CONTRACT_ADDRESS=
CREATOR_FUND_ADDRESS=
USDC_ADDRESS=
