{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npx turbo run build --filter=@opencast/desk...",
    "watchPatterns": [
      "apps/desk/**",
      "scripts/serve-static.mjs",
      "packages/**",
      "package.json",
      "package-lock.json",
      "turbo.json",
      "tsconfig.base.json",
      "nixpacks.toml",
      "deploy/railway/desk.json"
    ]
  },
  "deploy": {
    "startCommand": "node scripts/serve-static.mjs apps/desk/dist",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
