{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npx turbo run build --filter=@opencast/control...",
    "watchPatterns": [
      "apps/control/**",
      "packages/**",
      "package.json",
      "package-lock.json",
      "turbo.json",
      "tsconfig.base.json",
      "nixpacks.toml",
      "deploy/railway/control.json"
    ]
  },
  "deploy": {
    "startCommand": "npm run start -w @opencast/control",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
