{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npx turbo run build --filter=@opencast/api...",
    "watchPatterns": [
      "apps/api/**",
      "packages/**",
      "package.json",
      "package-lock.json",
      "turbo.json",
      "tsconfig.base.json",
      "nixpacks.toml",
      "deploy/railway/api.json"
    ]
  },
  "deploy": {
    "startCommand": "npm run start -w @opencast/api",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "preDeployCommand": [
      "npm run migrate -w @opencast/db"
    ]
  }
}
