{
  "name": "opencast",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "e2e"
  ],
  "scripts": {
    "env:check": "node scripts/env-check.mjs",
    "env:check:railway": "node scripts/env-check.mjs --railway",
    "contracts:test": "cd contracts && forge clean && forge test",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "turbo run build --filter=@opencast/domain && npm run migrate -w @opencast/db",
    "db:migrate:legacy": "npm run migrate:legacy -w @opencast/db --",
    "db:reset": "npm run reset -w @opencast/db && npm run migrate -w @opencast/db",
    "db:generate": "npm run generate -w @opencast/db",
    "test": "turbo run test",
    "predev": "turbo run build --filter=@opencast/domain --filter=@opencast/contracts",
    "dev": "concurrently -n API,WORKER,WEB -c blue,magenta,green \"PORT=8787 API_PORT=8787 npm run dev -w @opencast/api\" \"npm run dev -w @opencast/worker\" \"npm run dev -w @opencast/web\"",
    "predev:runtime": "turbo run build --filter=@opencast/domain --filter=@opencast/contracts",
    "dev:runtime": "concurrently -n API,WORKER,WEB -c blue,magenta,green \"PORT=8787 API_PORT=8787 npx tsx apps/api/src/server.ts\" \"npx tsx apps/worker/src/worker.ts\" \"npm run dev -w @opencast/web\"",
    "build": "turbo run build",
    "build:service:api": "turbo run build --filter=@opencast/api...",
    "build:service:worker": "turbo run build --filter=@opencast/worker...",
    "build:service:web": "turbo run build --filter=@opencast/web...",
    "start": "npm run start:runtime",
    "start:api": "node apps/api/dist/server.js",
    "start:worker": "node apps/worker/dist/worker.js",
    "start:service:api": "npm run start -w @opencast/api",
    "start:service:worker": "npm run start -w @opencast/worker",
    "start:service:web": "node scripts/serve-static.mjs apps/web/dist",
    "start:runtime": "node scripts/start-runtime.mjs",
    "start:railway": "npm run start:runtime",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "docs:api": "npm run docs:api -w @opencast/contracts",
    "db:seed": "npm run seed -w @opencast/db",
    "e2e": "npm test -w @opencast/e2e",
    "e2e:real": "npm run test:real -w @opencast/e2e",
    "e2e:quick": "npm run test:quick -w @opencast/e2e"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "railway": "^3.11.0",
    "turbo": "^2.11.5",
    "typescript": "^5.9.2"
  },
  "packageManager": "npm@11.3.0"
}
