API_PORT=8787
WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
STORAGE_ROOT=./storage
# Local Postgres and Redis from docker-compose.yml (`npm run db:up`).
DATABASE_URL=postgres://opencast:opencast@localhost:54329/opencast
REDIS_URL=redis://localhost:63799
REDIS_WORKER_LEADER_KEY=opencast:worker:leader
REDIS_WORKER_LEASE_SEC=15
SERVE_WEB_APP=true
WEB_DIST_DIR=./apps/web/dist
WORKER_POLL_INTERVAL_MS=1000
# The worker's file cache (a Railway volume): where, and how many GB of it to use (90% is filled).
WORKER_CACHE_DIR=
WORKER_CACHE_GB=100
# The worker's GET /health (cache hit rate, bytes cached, misses). Railway uses PORT.
WORKER_HEALTH_PORT=8788
MEDIA_BASE_URL=
KEEP_ORIGINAL_UPLOADS=false
# Set to 0 (or leave empty) to always attempt compression regardless of file size.
# Set to a positive byte limit only if you explicitly want to skip compression above that size.
MAX_COMPRESSION_INPUT_BYTES=0

# Hot-path storage for stream-ready assets:
#   r2     = Cloudflare R2 object storage (DEFAULT). Falls back to local disk if R2
#            is not configured or has no public base — never fails an upload.
#   hybrid = same as r2 but explicitly tolerant (R2 preferred, local fallback).
#   local  = local disk only (dev convenience).
# Legacy value "ipfs" is deprecated and treated as "hybrid" (IPFS is archival-only now).
UPLOAD_STORAGE_MODE=r2
DELETE_LOCAL_AFTER_R2=true
DELETE_LOCAL_AFTER_IPFS=true

# Object storage (v1): Cloudflare R2, or any S3-compatible store. Every file is keyed by
# its content ID (CIDv1, raw, sha-256); prepared files in Standard, originals in
# Infrequent Access. Set on api and worker only. Unset = local disk (storage/objects).
# R2_ENDPOINT defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_PUBLIC_BASE (a custom domain) serves previews and files by URL; without it
# URLs are presigned for R2_PRESIGN_TTL_SEC.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_PUBLIC_BASE=
R2_PRESIGN_TTL_SEC=21600

# Split-service deploys set this in apps/web/.env (or the Railway web service vars):
# VITE_API_BASE=https://<api-domain>

# Sign-in (Privy). The verification key is on the Privy dashboard; without it the API uses Privy's JWKS.
PRIVY_APP_ID=
PRIVY_VERIFICATION_KEY=
PRIVY_APP_SECRET=
# Clear as a Privy global wallet (docs/clear-integration.md): Clear's Privy app ID as the provider,
# and what Clear has granted Opencast in its Privy dashboard (read_only or full).
CLEAR_PRIVY_PROVIDER_APP_ID=
CLEAR_WALLET_ACCESS=read_only

# Where the viewer app lives, for links in notices and on QR codes
APP_ORIGIN=http://localhost:5174
# The API's own origin (A117): what it serves (/objects/..., /hls/..., receipt PDFs) is sent as full
# URLs on it, so the apps on other ports load them from the API. Unset: sent as paths.
API_PUBLIC_URL=http://localhost:8787
# Businesses' addresses to coordinates: a geocoding lookup with {q} in it, e.g.
# https://nominatim.openstreetmap.org/search?format=jsonv2&addressdetails=1&limit=1&countrycodes=us&q={q}
# Unset: looking up an address answers "not available" and businesses choose Online.
PLACES_URL=
# The escrow contract, shown on claimable stations' pages (Phase 6)
ESCROW_CONTRACT_ADDRESS=
# Encoders point here to go live
LIVE_INGEST_SERVER=rtmps://ingest.useopencast.org/live
# The minute tick (reminders, dead air, deadlines) runs in the worker, under its leader lock.
# Set JOBS=on to run it in the API instead (only without a worker).
JOBS=off
# Encoders without Livepeer: the worker listens for RTMP here while a live block is on.
LIVE_LISTEN_PORT=1935
# Run the old queue worker for stations still on the old model (the old master control).
LEGACY_PLAYOUT=on

# Livepeer
LIVEPEER_API_KEY=
LIVEPEER_API_BASE=https://livepeer.studio/api
LIVEPEER_RTMP_INGEST_BASE=rtmp://rtmp.livepeer.com/live
LIVEPEER_DEFAULT_ENABLED=true

# Pinata / IPFS — OPTIONAL archival/pinning tier only. Never on the live playout
# read path. Set IPFS_ARCHIVE_DEFAULT=true to also pin a permanent copy of every
# upload, or opt in per-upload via the `archiveToIpfs` request field.
IPFS_ARCHIVE_DEFAULT=false
# IPFS through Pinata: only the Opencast catalog and a station's own "Export to IPFS".
# Money (v1). fake: nothing real moves. clear: Clear accounts (the in-memory fake Clear until its
# API is wired; see docs/clear-integration.md), Stripe for cards. stripe_only: Stripe balances and
# Connect Express. A live Stripe key outside production is refused.
PAYMENTS_PROVIDER=fake
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# The escrow contract and creator fund (contracts/). Unset: claimable stations' earnings stay owed.
# Locally: anvil + contracts/README.md's deploy (addresses there); Base Sepolia for staging.
# SETTLEMENT_PRIVATE_KEY sends the weekly deposit and the pool's fund share; api and worker only.
CHAIN_RPC_URL=
CHAIN_ID=
USDC_ADDRESS=
CREATOR_FUND_ADDRESS=
SETTLEMENT_PRIVATE_KEY=

PINATA_JWT=
PINATA_UPLOAD_URL=https://uploads.pinata.cloud/v3/files
PINATA_GATEWAY_BASE=https://gateway.pinata.cloud/ipfs
PINATA_NETWORK=public

# External ingest (yt-dlp watchdogs)
EXTERNAL_INGEST_DOWNLOAD_TIMEOUT_MS=1800000
EXTERNAL_INGEST_DOWNLOAD_STALL_TIMEOUT_MS=240000
EXTERNAL_INGEST_EXPAND_TIMEOUT_MS=120000
EXTERNAL_INGEST_EXPAND_STALL_TIMEOUT_MS=45000
